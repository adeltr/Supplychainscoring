{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "edges",
 "type": "array",
 "items": {
  "type": "object",
  "required": [
   "from",
   "to",
   "kind",
   "source",
   "note"
  ],
  "properties": {
   "from": {
    "type": "string",
    "pattern": "^[0-9]{6}$"
   },
   "to": {
    "type": "string",
    "pattern": "^[0-9]{6}$"
   },
   "kind": {
    "enum": [
     "critique",
     "secondaire"
    ]
   },
   "source": {
    "type": "string",
    "minLength": 1
   },
   "note": {
    "type": "string",
    "minLength": 1
   }
  }
 }
}